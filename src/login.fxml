<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: #E8F5E9;"
      prefWidth="320">

    <Label text="Авторизация" styleClass="label-header"/>
    <TextField fx:id="loginField" promptText="Логин"/>
    <PasswordField fx:id="passwordField" promptText="Пароль"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Войти" onAction="#onSubmit"/>
        <Button text="Отмена" onAction="#onCancel"/>
    </HBox>
</VBox>