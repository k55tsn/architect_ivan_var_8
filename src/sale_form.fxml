<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.SaleFormController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: #E8F5E9;"
      prefWidth="440">

    <Label text="Продажа" styleClass="label-header"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Покупатель:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="buyerCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250"/>

        <Label text="Препарат:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="medicineCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250"/>

        <Label text="Количество:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Spinner fx:id="quantitySpinner" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="120"/>

        <Label text="Дата продажи:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="200"/>

        <Label text="Рецепт предъявлен:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <CheckBox fx:id="recipeCheck" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Сумма (руб.):" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="sumField" GridPane.columnIndex="1" GridPane.rowIndex="5" editable="false"/>
    </GridPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Сохранить" onAction="#onSave"/>
        <Button text="Отмена" onAction="#onCancel"/>
    </HBox>
</VBox>