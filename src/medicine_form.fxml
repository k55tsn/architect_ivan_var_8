<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.MedicineFormController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: #E8F5E9;"
      prefWidth="420">

    <Label text="Препарат" styleClass="label-header"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Наименование:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Категория:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="categoryCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200"/>

        <Label text="Цена (руб.):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="например, 150.50"/>

        <Label text="Требуется рецепт:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <CheckBox fx:id="needRecipeCheck" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Сохранить" onAction="#onSave"/>
        <Button text="Отмена" onAction="#onCancel"/>
    </HBox>
</VBox>